---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/playfair-display';
import "../styles/global.css";
import Slideshow from "../components/Slideshow.astro";
import Navbar from "../components/Navbar.astro";
import Consultations from "../components/Consultations.astro";
import Footer from "../components/Footer.astro";
import Form from "../components/Form.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Sunrise Homeopathy - Offering professional homeopathic consultations for various health concerns. Based in the UK."
    />
    <meta
      name="keywords"
      content="Homeopathy, Sunrise Homeopathy, Sue Lyn, Homeopathic consultations, Health, Wellness, Natural Remedies, Holistic, UK"
    />
    <title>Sunrise Homeopathy | S.L. Suresh</title>
    <link rel="canonical" href="https://sunrisehomeopathy.co.uk/" />
    <link rel="icon" href="./logo.svg" type="image/svg+xml" />

    <!-- Preload hero image for LCP -->
    <link rel="preload" as="image" href="/images/pfp.webp" type="image/webp" />

  </head>
  <body>
    <Navbar />
    <section class="main-page">
      <div class="main-left">
        <div class="intro flex flex-col">
          <div
            class="xl:grid xl:grid-cols-[auto_1fr] xl:gap-x-8 xl:gap-y-4 flex flex-col gap-6 items-start"
          >
            <div class="order-1 xl:col-start-2 xl:row-start-1 text-left">
              <h1
                class="text-4xl lg:text-5xl font-light tracking-wide text-left"
                style="font-family: var(--font-secondary);"
              >
                Homeopathy consultations with <span
                  class="italic"
                  style="color: var(--primary-color);">Sue (LCCH)</span
                >
              </h1>
            </div>
            <img
              class="order-2 xl:col-start-1 xl:row-span-2 w-full sm:w-64 object-cover rounded-l-full"
              src="/images/pfp.webp"
              alt="Sue Lyn Suresh - Homeopath"
              width="256"
              height="256"
              fetchpriority="high"
              style="aspect-ratio: 1 / 1;"
            />
            <div class="order-3 xl:col-start-2 xl:row-start-2 text-left">
              <p
                class="text-xl text-left"
                style="font-family: var(--font-primary);"
              >
                I am a homeopath, Graduated from the Contemporary College of
                Homeopathy, Bristol, UK.
              </p>
            </div>
          </div>
          <div class="dropdown-section fade-in">
            <button
              class="dropdown-toggle justify-start! xl:justify-end! gap-2"
            >
              <span>Certificates</span>
              <span class="dropdown-arrow">▼</span>
            </button>
            <div class="dropdown-content">
              <div
                class="mt-4 flex flex-col sm:flex-row items-center gap-4 w-full"
              >
                <img
                  class="w-full sm:w-1/2 max-h-100 object-contain rounded-md shadow-sm bg-gray-50/50"
                  src="/images/cert.webp"
                  alt="Licentiate Certification"
                  width="400"
                  height="533"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="w-full sm:w-1/2 max-h-100 object-contain rounded-md shadow-sm bg-gray-50/50"
                  src="/images/soh-cert.webp"
                  alt="Society of Homeopaths Registration"
                  width="400"
                  height="573"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="extra-text fade-in text-xl">
          <p>
            I offer a <span
              class="font-semibold"
              style="color: var(--primary-color);">safe and supportive</span
            > space to explore your health concerns through homeopathy. If you'd like
            to know more or book a consultation, please don't hesitate to get in touch.
          </p>
        </div>
      </div>

      <div class="main-right gradient-background py-12 mt-10">
        <h2
          style="font-family: var(--font-secondary);font-weight: 100;"
          class="leading-tight"
        >
          Request a private consultation <span class="font-medium">today.</span>
        </h2>
        <a
          href="#contact-section"
          class="btn-primary btn-right button-animation">Contact</a
        >
        <a href="#faq-section" class="btn-glass btn-right button-animation"
          >FAQ's</a
        >
        <a href="#pricing-section" class="btn-glass btn-right button-animation"
          >Consultations</a
        >
      </div>
    </section>

    <section class="slideshow-section my-24 px-4 sm:py-20">
      <Slideshow />
      <div class="text-xl mt-4 text-gray-600 text-center">
        <p>
          For more information on homeopathy, please visit the <a
            class="underline"
            href="https://www.homeopathy-soh.org/"
            target="_blank">Society of Homeopaths</a
          > website.
        </p>
      </div>
    </section>

    <section id="faq-section" class="my-24 text-white">
      <div class="faq">
        <h2 class="text-left text-4xl my-6 w-full font-secondary">
          Frequently Asked Questions
        </h2>
        <div>
          <h3 class="text-3xl my-4 font-secondary tracking-wide">
            How many sessions do I need?
          </h3>
          <p class="text-xl">
            That is hard to say. A simple acute case can usually be resolved
            quickly (covid, food poisoning, minor injuries), whereas a complex
            illness with many years of history needs plenty of time (months to
            years) to work through it. Examples are eczema, depression,
            autoimmune disorders, etc.
          </p>
        </div>
        <div>
          <h3 class="text-3xl my-4 font-secondary tracking-wide">
            Do I need my own kit?
          </h3>
          <p class="text-xl">
            I would always recommend buying a kit if you plan to use homeopathy
            long term as it can come in very handy for emergency situations.
            <a href="https://ainsworths.com/The-Essential-Kit/" target="_blank"
              >Ainsworths.com</a
            >
          </p>
        </div>
        <p class="font-secondary text-xl">
          If you have any other questions, feel free to get in touch.
        </p>
        <a
          href="#contact-section"
          class="w-40 rounded-lg my-5 text-[#51bc31]! text-center py-4 border bg-white border-gray-200 hover:border-white hover:text-white! transition-all hover:scale-102 hover:bg-transparent duration-300"
          >Contact
        </a>
      </div>
    </section>

    <section id="pricing-section" class="pricing my-20">
      <Consultations />
    </section>

    <section
      class="bg-[url('/images/colorFlow.webp')] pb-40 pt-6 bg-size-[100%_100%] bg-top"
      id="contact-section"
    >
      <h2
        class="text-4xl text-center mt-6 text-white font-secondary tracking-wide"
      >
        Book an Appointment / Enquire
      </h2>
      <div class="max-w-xl mx-auto py-12 px-4">
        <div
          class="contact-container flex flex-col items-center text-center py-6 bg-black/10 border border-gray-300 rounded-2xl shadow-lg backdrop-blur-lg"
        >
          <a
            href="mailto:lavenderthyme@protonmail.com"
            class="text-white text-xl hover:text-gray-300"
            >Email me: <span class="underline"
              >lavenderthyme@protonmail.com</span
            ></a
          >
        </div>

        <p class="text-2xl text-white font-secondary text-center my-6">Or</p>

        <Form />
      </div>
    </section>

    <section class="footer">
      <Footer />
    </section>
    <script type="module" src="/js/dropdown.js"></script>
    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      const lenis = new Lenis({
        autoRaf: true,
        anchors: true,
      });

      declare global {
        interface Window {
          lenis: Lenis;
        }
      }

      window.lenis = lenis;
    </script>
  </body>
</html>
