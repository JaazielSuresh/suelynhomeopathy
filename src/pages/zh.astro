---
import "../styles/global.css";
import Slideshow from "../components/Slideshow.astro";
import Navbar from "../components/Navbar.astro";
import Consultations from "../components/Consultations.astro";
import Footer from "../components/Footer.astro";
import Form from "../components/Form.astro";
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Sunrise 顺势疗法 - 为各种健康问题提供专业的顺势疗法咨询。总部位于英国。"
    />
    <meta
      name="keywords"
      content="顺势疗法, Sunrise Homeopathy, Sue Lyn, 顺势疗法咨询, 健康, 养生, 自然疗法, 整体疗法, 英国"
    />
    <title>Sunrise 顺势疗法 | S.L. Suresh</title>
    <link rel="canonical" href="https://sunrisehomeopathy.co.uk/zh" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />

    <!-- Google Fonts Optimized -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..600;1,9..40,300..600&family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar lang="zh" />
    <section class="main-page">
      <div class="main-left">
        <div class="intro flex flex-col">
          <div
            class="xl:grid xl:grid-cols-[auto_1fr] xl:gap-x-8 xl:gap-y-4 flex flex-col gap-6 fade-in items-start"
          >
            <div class="order-1 xl:col-start-2 xl:row-start-1 text-left">
              <h1
                class="text-4xl lg:text-5xl font-light tracking-wide text-left"
                style="font-family: var(--font-secondary);"
              >
                与 <span
                  class="italic"
                  style="color: var(--primary-color);">Sue (LCCH)</span
                > 的顺势疗法咨询
              </h1>
            </div>
            <img
              class="order-2 xl:col-start-1 xl:row-span-2 w-full sm:w-64 object-cover rounded-l-full"
              src="/images/pfp.webp"
              alt="Sue Lyn Suresh - 顺势疗法医师"
              width="256"
              height="256"
              fetchpriority="high"
              style="aspect-ratio: 1 / 1;"
            />
            <div class="order-3 xl:col-start-2 xl:row-start-2 text-left">
              <p
                class="text-xl text-left"
                style="font-family: var(--font-primary);"
              >
                我是一名顺势疗法医师，毕业于英国布里斯托尔现代顺势疗法学院。
              </p>
            </div>
          </div>
          <div class="dropdown-section fade-in">
            <button
              class="dropdown-toggle justify-start! xl:justify-end! gap-2"
            >
              <span>证书</span>
              <span class="dropdown-arrow">▼</span>
            </button>
            <div class="dropdown-content">
              <div
                class="mt-4 flex flex-col sm:flex-row items-center gap-4 w-full"
              >
                <img
                  class="w-full sm:w-1/2 max-h-100 object-contain rounded-md shadow-sm bg-gray-50/50"
                  src="/images/cert.webp"
                  alt="执业证书"
                  width="400"
                  height="533"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="w-full sm:w-1/2 max-h-100 object-contain rounded-md shadow-sm bg-gray-50/50"
                  src="/images/soh-cert.webp"
                  alt="顺势疗法协会注册"
                  width="400"
                  height="573"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="extra-text fade-in text-xl">
          <p>
            我提供一个<span
              class="font-semibold"
              style="color: var(--primary-color);">安全、支持性</span
            >的空间，通过顺势疗法探索您的健康问题。如果您想了解更多或预约咨询，请随时与我联系。
          </p>
        </div>
      </div>

      <div class="main-right fade-in-right gradient-background py-12 mt-10">
        <h2
          style="font-family: var(--font-secondary);font-weight: 100;"
          class="leading-tight"
        >
          <span class="font-medium">立即</span>预约私人咨询。
        </h2>
        <a
          href="#contact-section"
          class="btn-primary btn-right button-animation">联系</a
        >
        <a href="#faq-section" class="btn-glass btn-right button-animation"
          >常见问题</a
        >
        <a href="#pricing-section" class="btn-glass btn-right button-animation"
          >咨询服务</a
        >
      </div>
    </section>

    <section class="slideshow-section my-24 px-4 sm:py-20">
      <Slideshow lang="zh" />
      <div class="text-xl mt-4 text-gray-600 text-center">
        <p>
          欲了解更多有关顺势疗法的信息，请访问<a
            class="underline"
            href="https://www.homeopathy-soh.org/"
            target="_blank">顺势疗法协会</a
          >网站。
        </p>
      </div>
    </section>

    <section id="faq-section" class="my-24 text-white">
      <div class="faq">
        <h2 class="text-left text-4xl my-6 w-full font-secondary">
          常见问题解答
        </h2>
        <div>
          <h3 class="text-3xl my-4 font-secondary tracking-wide">
            我需要多少次疗程？
          </h3>
          <p>
            这很难说。简单的急性病症通常可以很快解决（如新冠、食物中毒、轻微受伤），而有着多年病史的复杂疾病则需要大量时间（数月甚至数年）来调理。例如湿疹、抑郁症、自身免疫性疾病等。
          </p>
        </div>
        <div>
          <h3 class="text-3xl my-4 font-secondary tracking-wide">
            我需要自己的药箱吗？
          </h3>
          <p>
            如果您计划长期使用顺势疗法，我始终建议购买一个药箱，它在紧急情况下会非常有用。
            <a href="https://ainsworths.com/The-Essential-Kit/" target="_blank"
              >Ainsworths.com</a
            >
          </p>
        </div>
        <p class="font-secondary">
          如果您有任何其他问题，欢迎随时联系。
        </p>
        <a
          href="#contact-section"
          class="w-40 rounded-lg my-5 text-[#51bc31]! text-center py-4 border bg-white border-gray-200 hover:border-white hover:text-white! transition-all hover:scale-102 hover:bg-transparent duration-300"
          >联系
        </a>
      </div>
    </section>

    <section id="pricing-section" class="pricing my-20">
      <Consultations lang="zh" />
    </section>

    <section
      class="bg-[url('/images/colorFlow.webp')] pb-40 pt-6 bg-size-[100%_100%] bg-top"
      id="contact-section"
    >
      <h2
        class="text-4xl text-center mt-6 text-white font-secondary tracking-wide"
      >
        预约 / 咨询
      </h2>
      <div class="max-w-xl mx-auto py-12 px-4">
        <div
          class="contact-container flex flex-col items-center text-center py-6 bg-black/10 border border-gray-300 rounded-2xl shadow-lg backdrop-blur-lg"
        >
          <a
            href="mailto:lavenderthyme@protonmail.com"
            class="text-white text-xl hover:text-gray-300"
            >电邮联系：<span class="underline"
              >lavenderthyme@protonmail.com</span
            ></a
          >
        </div>

        <p class="text-2xl text-white font-secondary text-center my-6">或</p>

        <Form lang="zh" />
      </div>
    </section>

    <section class="footer">
      <Footer lang="zh" />
    </section>
    <script type="module" src="/js/dropdown.js"></script>
    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      const lenis = new Lenis({
        autoRaf: true,
        anchors: true,
      });

      declare global {
        interface Window {
          lenis: Lenis;
        }
      }

      window.lenis = lenis;
    </script>
  </body>
</html>
