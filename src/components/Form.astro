---
const { lang = "en" } = Astro.props;

const t = {
  en: {
    name: "Name",
    emailHelper: "Please enter a valid email address (e.g. name@example.com)",
    email: "Email",
    phone: "Phone Number (optional)",
    message: "Message",
    submit: "Submit",
  },
  zh: {
    name: "姓名",
    emailHelper: "请输入有效的电子邮件地址（例如 name@example.com）",
    email: "电子邮件",
    phone: "电话号码（可选）",
    message: "留言",
    submit: "提交",
  },
};
const i18n = t[lang as keyof typeof t];
---

<div
  class="bg-black/10 backdrop-blur-lg border border-gray-300 px-4 py-8 rounded-2xl shadow-lg w-full"
>
  <form
    id="contact-form"
    action="https://formspree.io/f/mdagznoa"
    method="POST"
    class="flex flex-col gap-4"
  >
    <input
      type="text"
      name="Name"
      placeholder={i18n.name}
      required
      class="w-full border border-gray-300 rounded-lg p-3 text-xl focus:outline-none focus:ring-1 focus:ring-white placeholder-white bg-transparent focus:bg-transparent text-white"
    />
    <div class="flex flex-col gap-1.5">
      <p id="email-helper" class="hidden text-sm text-white/80">
        {i18n.emailHelper}
      </p>
      <div class="relative w-full">
        <input
          id="email-input"
          type="email"
          name="Email"
          placeholder={i18n.email}
          required
          class="w-full border border-gray-300 rounded-lg p-3 pr-11 text-xl focus:outline-none focus:ring-1 focus:ring-white placeholder-white bg-transparent focus:bg-transparent text-white"
        />
        <span
          id="email-valid-icon"
          class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 text-white pointer-events-none"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </span>
      </div>
    </div>
    <input
      type="tel"
      name="Phone"
      placeholder={i18n.phone}
      class="w-full border border-gray-300 rounded-lg p-3 text-xl focus:outline-none focus:ring-1 focus:ring-white placeholder-white bg-transparent focus:bg-transparent text-white"
    />
    <textarea
      name="Message"
      placeholder={i18n.message}
      rows="4"
      required
      class="w-full border border-gray-300 rounded-lg p-3 text-xl focus:outline-none focus:ring-1 focus:ring-white placeholder-white bg-transparent focus:bg-transparent text-white resize-none"
    ></textarea>
    <button
      id="submit-btn"
      type="submit"
      disabled
      class="w-full text-white text-xl py-3 rounded-lg bg-transparent border border-gray-100 transition-all duration-300 mt-2 font-medium disabled:opacity-40 disabled:cursor-not-allowed disabled:pointer-events-none hover:border-white hover:bg-white hover:text-[#51bc31]"
      >{i18n.submit}</button
    >
  </form>
</div>

<style>
  input,
  textarea {
    background-color: transparent !important;
  }
  input:-webkit-autofill,
  textarea:-webkit-autofill {
    -webkit-text-fill-color: #fff !important;
    caret-color: #fff !important;
    transition: background-color 5000000s ease-in-out 0s !important;
    background-color: transparent !important;
  }
</style>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const submitBtn = document.getElementById(
    "submit-btn",
  ) as HTMLButtonElement | null;
  const emailInput = document.getElementById(
    "email-input",
  ) as HTMLInputElement | null;
  const emailHelper = document.getElementById("email-helper");
  const emailValidIcon = document.getElementById("email-valid-icon");

  if (form && submitBtn) {
    const requiredInputs = form.querySelectorAll<
      HTMLInputElement | HTMLTextAreaElement
    >("[required]");

    const checkFormValidity = () => {
      const hasText = !!emailInput?.value.trim();
      const isEmailValid = hasText && !!emailInput?.checkValidity();

      emailHelper?.classList.toggle("hidden", !(hasText && !isEmailValid));
      emailValidIcon?.classList.toggle("hidden", !isEmailValid);

      submitBtn.disabled = !Array.from(requiredInputs).every(
        (input) => input.value.trim() !== "" && input.checkValidity(),
      );
    };

    form.addEventListener("input", checkFormValidity);
    checkFormValidity();
  }
</script>
